#!/usr/bin/env bash
# Start the slack-ops orchestrator in a tmux session.
# Idempotent — safe to run if already running.

set -euo pipefail

SESSION_NAME="claude-ops"
WORK_DIR="$HOME/.local/share/slack-ops"

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Orchestrator already running in tmux session '$SESSION_NAME'."
    echo "Attach with: tmux attach -t $SESSION_NAME"
    exit 0
fi

mkdir -p "$WORK_DIR"

echo "Starting slack-ops orchestrator..."
tmux new-session -d -s "$SESSION_NAME" -c "$WORK_DIR" \
  "while true; do claude --agent slack-orchestrator --dangerously-skip-permissions --add-dir /home/vm --effort medium; echo 'Orchestrator exited. Restarting in 5s...'; sleep 5; done"

# Wait for Claude to fully start (check for INSERT mode in status line)
echo -n "Waiting for Claude to start"
for i in $(seq 1 20); do
    sleep 3
    echo -n "."
    if tmux capture-pane -t "$SESSION_NAME" -p 2>/dev/null | grep -q "INSERT"; then
        echo " ready."
        tmux send-keys -t "$SESSION_NAME" "Start polling now." Enter
        sleep 1
        tmux send-keys -t "$SESSION_NAME" Enter
        break
    fi
done
echo ""

# Ensure health check cron is active
if ! crontab -l 2>/dev/null | grep -q "claude-ops-health"; then
    (crontab -l 2>/dev/null; echo "*/5 * * * * /home/vm/.local/bin/claude-ops-health") | crontab -
    echo "Health check cron enabled."
fi

echo "Orchestrator started in tmux session '$SESSION_NAME'."
echo "Attach with: tmux attach -t $SESSION_NAME"
echo "Stop with: claude-ops-stop"
