#!/usr/bin/env bash
# Start the slack-ops orchestrator in a tmux session.
# Idempotent — safe to run if already running.

set -euo pipefail

SESSION_NAME="claude-ops"
WORK_DIR="$HOME/.claude/slack-ops"

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Orchestrator already running in tmux session '$SESSION_NAME'."
    echo "Attach with: tmux attach -t $SESSION_NAME"
    exit 0
fi

mkdir -p "$WORK_DIR"

echo "Starting slack-ops orchestrator..."
tmux new-session -d -s "$SESSION_NAME" -c "$WORK_DIR" \
  "claude --agent slack-orchestrator --dangerously-skip-permissions --add-dir /home/vm"

# Wait for Claude to start, then send the startup prompt
sleep 8
tmux send-keys -t "$SESSION_NAME" \
  "Start polling. Read config.json and registry.json in the current directory, then begin the poll cycle as described in your agent instructions." Enter

echo "Orchestrator started in tmux session '$SESSION_NAME'."
echo "Attach with: tmux attach -t $SESSION_NAME"
