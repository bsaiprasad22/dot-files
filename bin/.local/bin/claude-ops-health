#!/usr/bin/env bash
# Health check for the slack-ops orchestrator.
# Restarts if the tmux session is dead.
# Intended for cron: */5 * * * * /home/vm/.local/bin/claude-ops-health

set -euo pipefail

SESSION_NAME="claude-ops"
WORK_DIR="$HOME/.claude/slack-ops"
LOG_FILE="$WORK_DIR/health.log"

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    exit 0
fi

# Session is dead — restart
mkdir -p "$WORK_DIR"
echo "$(date -Iseconds) — Orchestrator not found, restarting..." >> "$LOG_FILE"

CLAUDE_BIN="$HOME/.local/bin/claude"
tmux new-session -d -s "$SESSION_NAME" -c "$WORK_DIR" \
  "$CLAUDE_BIN --agent slack-orchestrator --dangerously-skip-permissions --add-dir /home/vm"

# Wait for Claude to fully start (check for INSERT mode in status line)
for i in $(seq 1 20); do
    sleep 3
    if tmux capture-pane -t "$SESSION_NAME" -p 2>/dev/null | grep -q "INSERT"; then
        tmux send-keys -t "$SESSION_NAME" "Start polling now." Enter
        sleep 1
        tmux send-keys -t "$SESSION_NAME" Enter
        echo "$(date -Iseconds) — Orchestrator restarted." >> "$LOG_FILE"
        exit 0
    fi
done

echo "$(date -Iseconds) — Orchestrator failed to start within 60s." >> "$LOG_FILE"

# Rotate log if > 1MB
if [[ -f "$LOG_FILE" ]] && [[ $(stat -f%z "$LOG_FILE" 2>/dev/null || stat -c%s "$LOG_FILE" 2>/dev/null) -gt 1048576 ]]; then
    mv "$LOG_FILE" "${LOG_FILE}.old"
fi
