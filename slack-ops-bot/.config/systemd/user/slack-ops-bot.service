[Unit]
Description=Slack Ops Bot — Claude task orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/slack-ops
ExecStart=%h/.local/share/slack-ops-bot/.venv/bin/python -m slack_ops_bot.main
EnvironmentFile=%h/.local/share/slack-ops-bot/.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=slack-ops-bot

[Install]
WantedBy=default.target
