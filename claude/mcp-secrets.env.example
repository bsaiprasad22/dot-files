# Example MCP secrets file.
# Copy to ~/.config/claude/mcp-secrets.env, fill in real values, chmod 600.
# ~/.zshrc sources the real file if it exists; claude/.mcp.json references these vars.
#
# Required for Claude Code to start without 401s. Claude Code refuses to parse
# .mcp.json if any referenced env var is unset and has no default.

export ATLASSIAN_CLOUD_AUTH='Basic <atlassian-cloud-token-format>'
export PENSANDO_JIRA_AUTH='<email>:<atlassian-token>'
export JENKINS_BASIC_AUTH='Basic <base64(user:pass)>'
