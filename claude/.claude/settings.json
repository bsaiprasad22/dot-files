{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "## Git ##",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git tag *)",
      "Bash(git rev-parse *)",
      "Bash(git config *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "## Node / JS ##",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(npm audit *)",
      "Bash(npm ci *)",
      "Bash(npx *)",
      "## Python ##",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(pip list *)",
      "Bash(pip show *)",
      "Bash(pytest *)",
      "## Build / Test / Lint ##",
      "Bash(make *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "## Docker ##",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker images *)",
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(docker run *)",
      "Bash(docker version *)",
      "Bash(docker restart *)",
      "Bash(docker build *)",
      "Bash(docker network *)",
      "Bash(docker stop *)",
      "Bash(docker start *)",
      "Bash(docker cp *)",
      "## System / Debug ##",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(env)",
      "Bash(netstat *)",
      "Bash(ss *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(xargs *)",
      "Bash(stow *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(date *)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "## GitHub CLI ##",
      "Bash(gh *)",
      "## Claude CLI ##",
      "Bash(claude plugin list *)",
      "Bash(claude plugin marketplace *)",
      "Bash(claude plugin --help *)",
      "Bash(claude plugin install *)",
      "Bash(claude plugin disable *)",
      "Bash(claude plugin enable *)",
      "Bash(claude plugin uninstall *)",
      "Bash(claude plugin update *)",
      "Bash(claude plugin validate *)",
      "## tmux ##",
      "Bash(tmux *)",
      "## MCP Servers ##",
      "mcp__pensando_jira__*",
      "mcp__cloud_atlassian__*",
      "mcp__plugin_agentq_slack__*",
      "## Web ##",
      "WebSearch",
      "WebFetch",
      "Bash(.venv/bin/pip install:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/alembic upgrade:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/pip show:*)",
      "Bash(source:*)",
      "Bash(git commit:*)",
      "Bash(echo === List submissions \\(empty collection\\) ===:*)",
      "Bash(find /home/vm/penops-ui -type f \\\\\\(-name *cherry* -o -name *Cherry* -o -name *cherrypick* \\\\\\))",
      "Bash(find /home/vm/penops-ui -maxdepth 3 -type f \\\\\\(-name *.sh -o -name *.py -o -name Makefile -o -name *.yml -o -name *.yaml \\\\\\))",
      "Bash(~/.claude/notify.sh)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-7[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-to-slack.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-to-slack.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__pensando_jira__create_issue",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/jira-auto-assign.sh"
          }
        ]
      },
      {
        "matcher": "mcp__pensando_jira__batch_create_issues",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/jira-auto-assign.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@superpowers-dev": true,
    "agentq@ntsg_claude_plugins": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "ntsg_claude_plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:pensando/ntsg_claude_plugins.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
